# Copy this file to .env before running Docker Compose.
# Replace both values with unique, randomly generated values for deployments.
POSTGRES_PASSWORD=change-this-to-a-random-url-safe-password
SECRET_KEY=change-this-to-a-random-secret-at-least-32-characters
COOKIE_SECURE=false

# Optional: create an administrator account on first startup.
ADMIN_EMAIL=
ADMIN_PASSWORD=
